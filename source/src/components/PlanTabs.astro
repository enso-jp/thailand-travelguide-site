---
import { PLAN_TABS, activePlanTab } from '../lib/plan-tabs';
import { pageHref } from '../lib/site';

interface Props {
  path: string;
}

const { path } = Astro.props;
const active = activePlanTab(path);
---

<div class="plan-tabbar">
  <nav class="tabs plan-tabs wrap" aria-label="Plan a trip">
    {
      PLAN_TABS.map((tab) => (
        <a href={pageHref(tab.href)} aria-current={active === tab.id ? 'page' : undefined}>
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>
