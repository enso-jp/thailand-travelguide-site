---
import { SISTER_CROSS_BORDER_ROUTES, allowsBkkDadFlight, allowsVietnamFlights, thaiDomesticFlightsForPath } from '../lib/sister-network';
interface Props {
  path: string;
}
const { path } = Astro.props;
const showDad = allowsBkkDadFlight(path);
const showVn = allowsVietnamFlights(path);
const domestic = showVn ? [] : thaiDomesticFlightsForPath(path);
import FlightCta from './FlightCta.astro';
---

<section class="place-section home-section sister-routes" id="vietnam-routes" aria-label="Combine Thailand and Vietnam routes">
  <div class="sister-head">
    <span class="sister-badge">
      <i class="net-mark net-mark-vn" aria-hidden="true">V</i>
      Two-Country Trip Planning
    </span>
    <h2>Combine Thailand & Vietnam: Nonstop Flights & 2-Country Routes</h2>
    <p class="sister-lead">
      Bangkok and Chiang Mai sit under two hours nonstop from Hanoi, Ho Chi Minh City, and Da Nang. Pair your Thailand itinerary with our sister guide <a href="https://vietnam-travelguide.com/" target="_blank" rel="noopener">Vietnam TravelGuide</a>.
    </p>
  </div>
  <div class="sister-route-grid">
    {
      SISTER_CROSS_BORDER_ROUTES.map((route) => (
        <article class="sister-route-card">
          <span class="sister-kicker">{route.kicker}</span>
          <h3>{route.title}</h3>
          <p>{route.summary}</p>
          <div class="sister-route-links">
            {route.links.map((link) => (
              <a class="sister-chip" href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            ))}
          </div>
          {showVn && (route.flight.toCode !== 'DAD' || showDad) && (
            <FlightCta
              href={route.flight.href}
              route={route.flight.route}
              fromCode={route.flight.fromCode}
              toCode={route.flight.toCode}
              duration={route.flight.duration}
            />
          )}
        </article>
      ))
    }
  </div>
  {domestic.length > 0 && (
    <div class="sister-flights" aria-label="Flights on Trip.com">
      {domestic.map((fl) => (
        <FlightCta href={fl.href} route={fl.route} fromCode={fl.fromCode} toCode={fl.toCode} duration={fl.duration} />
      ))}
    </div>
  )}
</section>
