---
interface Props {
  id?: string;
  src?: string;
  alt?: string;
  cover?: boolean;
  priority?: boolean;
  width?: number;
  height?: number;
}

const { src, alt = '', priority = false, width = 960, height = 640 } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
/>
