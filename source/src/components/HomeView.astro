---
import BookStay from './BookStay.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import RegionStage from './RegionStage.astro';
import SisterRoutes from './SisterRoutes.astro';
import { buildHomeMedia } from '../lib/page-media';
import { allStories, displayDate, isoDate, storyPath, STORIES_PATH } from '../lib/stories';
import { pageHref } from '../lib/site';

const home = buildHomeMedia();
const stories = (await allStories()).slice(0, 6);
const chips = [
  { href: '/destinations/', label: 'Destinations' },
  { href: '/thai-food/', label: 'Food' },
  { href: '/itineraries/', label: 'Itineraries' },
  { href: '/plan/', label: 'Plan a trip' },
];

function dots(n: number): string {
  return '●'.repeat(n) + '○'.repeat(Math.max(0, 5 - n));
}
---

<div class="home wrap">
  <section class="home-hero" aria-label="Thailand travel guide">
    <Photo src={home.lead.photo} alt="" priority />
    <div class="home-hero-copy">
      <h1>{home.lead.title}</h1>
      {home.lead.sub && <p class="home-hero-sub">{home.lead.sub}</p>}
      <a class="pill pill-light" href={pageHref(home.lead.href)}>See the guide</a>
      <nav class="home-quick" aria-label="Quick links">
        {chips.map((chip) => (
          <a href={pageHref(chip.href)}>{chip.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="home-facts" aria-label="Quick facts">
    <div class="facts" style="--fact-cols:3">
      {
        home.facts.map((fact) => (
          <a href={pageHref(fact.href)}>
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </a>
        ))
      }
    </div>
  </section>

  <div class="home-split">
    <div class="home-collage">
      {
        home.collage.map((story) => (
          <a class={`collage-tile ${story.spot}`} href={pageHref(story.href)}>
            <Photo src={story.photo} alt={story.title} />
            <span class="collage-copy">
              <small><i class="hero-mark" aria-hidden="true"></i>{story.kicker}</small>
              <strong>{story.title}</strong>
            </span>
          </a>
        ))
      }
    </div>
    <div class="home-rail">
      <BookStay />
    </div>
  </div>

  <RegionStage regions={home.regions} />

  <section class="home-section dest-top">
    <h2>Top destinations in Thailand</h2>
    <div class="top-grid">
      {
        home.topPlaces.map((place, index) => (
          <a class="top-card" href={pageHref(place.href)}>
            <span class="top-photo">
              <Photo src={place.photo} alt={place.name} />
              <span class="rank-badge">{index + 1}</span>
            </span>
            <span class="top-copy">
              <strong>
                {place.name}
                <span class="edots" aria-label={`${place.dots} of 5`}><span aria-hidden="true">{dots(place.dots)}</span></span>
              </strong>
              <em>{place.line}</em>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <h2>Plan your trip</h2>
    <div class="plan-row">
      {
        home.plan.map((tool) => (
          <a href={pageHref(tool.href)}>
            <span class="plan-icon"><Icon name={tool.icon} /></span>
            <strong>{tool.title}</strong>
            <span>{tool.text}</span>
          </a>
        ))
      }
    </div>
    <p class="home-actions"><a class="pill" href={pageHref('/plan/')}>See all planning tools</a></p>
  </section>

  <section class="home-section">
    <h2>Popular trips and routes</h2>
    <div class="plan-row">
      {
        home.trips.map((tool) => (
          <a href={pageHref(tool.href)}>
            <span class="plan-icon"><Icon name={tool.icon} /></span>
            <strong>{tool.title}</strong>
            <span>{tool.text}</span>
          </a>
        ))
      }
    </div>
    <p class="home-actions"><a class="pill" href={pageHref('/itineraries/')}>See itineraries</a></p>
  </section>

  <section class="home-section">
    <h2>Find your interest</h2>
    <div class="interest-grid">
      {
        home.interests.map((item) => (
          <a class="home-tile" href={pageHref(item.href)}>
            <Photo src={item.photo} alt={item.label} />
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>
    <p class="home-actions"><a class="pill" href={pageHref('/interests/')}>See all interests</a></p>
  </section>

  <SisterRoutes path="/" />

  <section class="home-section home-stories" id="stories">
    <h2>Stories</h2>
    <ul class="home-story-rows">
      {
        stories.map((story) => (
          <li>
            <a class="home-story-row" href={pageHref(storyPath(story))}>
              <span class="home-story-thumb">
                <Photo src={story.data.photo} alt="" width={160} height={120} />
              </span>
              <span class="home-story-copy">
                <strong>{story.data.title}</strong>
                <time datetime={isoDate(story.data.date)}>{displayDate(story.data.date)}</time>
                <span>{story.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="home-actions"><a class="pill" href={pageHref(STORIES_PATH)}>More stories</a></p>
  </section>
</div>
