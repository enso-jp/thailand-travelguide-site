---
import CheckedLine from './CheckedLine.astro';
import { klookFallbackCta } from '../lib/partners';
import FactBar from './FactBar.astro';
import PortraitRail from './PortraitRail.astro';
import AffRow from './AffRow.astro';
import FaqList from './FaqList.astro';
import SisterNetwork from './SisterNetwork.astro';
import SisterRoutes from './SisterRoutes.astro';
import { flightKeysInPage } from '../lib/sister-network';
import { getPage, type Page } from '../lib/content';
import { chipHref, formatInline } from '../lib/inline';
import { pageHref, routePath } from '../lib/site';
import { UniquePhotos } from '../lib/photos';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const bag = new UniquePhotos(page.photo ? [page.photo] : []);
const portraits = bag.takeBatch(page.portraits || [], (item) => `${page.path} ${item.title} ${item.href}`);
const days = bag.takeBatch(page.days || [], (day) => `${page.path} ${day.title} ${day.body}`);
const sections = (page.sections || []).map((section) => ({
  ...section,
  cards: section.cards?.map((card) => ({
    ...card,
    photo: bag.take(card.photo, `${page.path} ${card.kicker} ${card.title} ${card.href || ""}`),
  })),
  affiliates: section.affiliates
    ? bag.takeBatch(section.affiliates, (item) => `${page.path} ${item.title} ${item.kicker} ${item.body}`)
    : undefined,
}));
const leadSections = sections.filter((section) => section.lead);
const restSections = sections.filter((section) => !section.lead);
const shownAffHrefs = new Set(
  [
    ...sections.flatMap((section) => (section.affiliates || []).map((item) => item.href)),
    // The booking CTA above already shows these; keep the first copy only.
    ...(page.bookingCta ? [page.bookingCta.stayHref, page.bookingCta.tourHref] : []),
  ],
);
const affiliates = bag.takeBatch(
  (page.affiliates || []).filter((item) => !shownAffHrefs.has(item.href)),
  (item) => `${page.path} ${item.title} ${item.kicker} ${item.body}`,
);
const tabs = page.tabs;
const pageFlightKeys = flightKeysInPage(page);
const ROUTE_STAYS: Record<string, string[]> = {
  'phuket-to-krabi-phi-phi': ['koh-phi-phi', 'krabi'],
};
const routeSlug = page.path.startsWith('/get-there/') ? page.path.slice('/get-there/'.length).replace(/\/$/, '') : '';
const routeDests = routeSlug ? ROUTE_STAYS[routeSlug] || [routeSlug.split('-to-')[1]] : [];
const stayLinks = routeDests
  .map((slug) => getPage(`/${slug}/where-to-stay`))
  .filter((p): p is Page => Boolean(p));
const showSisterRoutes = page.path === '/get-there' || page.path.startsWith('/get-there/') || page.path === '/itineraries' || page.path.startsWith('/itineraries/') || page.path === '/plan';
const useGuideGrid =
  (page.portraits?.length || 0) > 0 &&
  (page.path === '/destinations' ||
    page.path.startsWith('/destinations/') ||
    page.path === '/itineraries' ||
    page.path === '/plan' ||
    page.path === '/get-there' ||
    page.path === '/thai-food' ||
    page.path === '/attractions' ||
    (page.path.startsWith('/interests') && !/^\/interests\/nightlife\//.test(page.path)));

function guideGridHeading(path: string): string {
  if (path === '/interests/resort-living') return 'Flagship resorts by destination';
  if (path === '/interests/nightlife') return 'Nightlife districts and beach clubs';
  if (path === '/interests') return 'Explore by travel style';
  if (path === '/thai-food') return 'Regional kitchens, street markets, and dishes';
  if (path === '/attractions') return 'Landmarks, marine parks, and cultural sights';
  if (path === '/destinations' || path.startsWith('/destinations/')) return 'Destinations to compare';
  if (path === '/itineraries') return 'Routes by trip length';
  if (path === '/plan') return 'Essential trip planning guides';
  if (path === '/get-there') return 'Key transport routes';
  if (path.startsWith('/interests/')) return 'Top destinations for this interest';
  return 'Guides on this hub';
}
const bookingTourCta = klookFallbackCta(page.bookingCta?.tourHref);
---

<article class="section wrap">
  {
    page.crumbs.length > 1 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {page.crumbs.map((crumb) => (
            <li>
              <a href={pageHref(crumb.href)}>{crumb.name}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <header>
    <h1>{page.title}</h1>
    <CheckedLine path={page.path} />
    <p class="lede" set:html={formatInline(page.lede)} />
    {
      page.parentPill && routePath(page.parentPill.href) !== page.path && (
        <a class="chip parent-pill" href={pageHref(page.parentPill.href)}>
          <span>Back to</span> {page.parentPill.name}
        </a>
      )
    }
    {
      page.chips && page.chips.length > 0 && (
        <div class="chips">
          {page.chips.map((chip) => {
            const href = chipHref(chip, page.parentPill, page.path);
            return href && routePath(href) !== page.path ? (
              <a class="chip parent-pill" href={pageHref(href)}>
                {chip}
              </a>
            ) : (
              <span class="chip peak">{chip}</span>
            );
          })}
        </div>
      )
    }
    {
      page.photo && (
        <figure class="place-photo">
          <img src={page.photo} alt={page.title} width="960" height="540" loading="eager" decoding="async" />
          {page.photoCredit && <figcaption class="photo-credit">{page.photoCredit}</figcaption>}
        </figure>
      )
    }
  </header>

  <FactBar facts={page.facts} />

  {
    page.bookingCta && (
      <div class="booking-cta" aria-label="Book stays and tickets">
        <a href={page.bookingCta.stayHref} rel="sponsored noopener" target="_blank">
          <strong>{page.bookingCta.stayLabel}</strong>
          <em>{page.bookingCta.stayNote}</em>
        </a>
        <a href={page.bookingCta.tourHref} rel="sponsored noopener" target="_blank">
          <strong>{bookingTourCta ? bookingTourCta.label : page.bookingCta.tourLabel}</strong>
          <em>{bookingTourCta ? bookingTourCta.note : page.bookingCta.tourNote}</em>
        </a>
      </div>
    )
  }

  {
    tabs && tabs.length > 0 && (
      <nav class="tabs" aria-label="Sections" tabindex="0">
        {tabs.map((tab) => (
          <a href={pageHref(tab.href)} aria-current={tab.current ? 'page' : undefined}>
            {tab.label}
          </a>
        ))}
      </nav>
    )
  }

  <div class="reading">
    {page.paragraphs.map((p) =>
      /^- /.test(p) ? (
        <ul class="scan-list">
          {p.split(/\s+-\s+(?=\*\*)/).map((line) => <li set:html={formatInline(line.replace(/^- /, ''))} />)}
        </ul>
      ) : (
        <p set:html={formatInline(p)} />
      ),
    )}
  </div>

  {leadSections.map((section) => (
    <section class="place-section" id={section.id}>
      <h2>{section.title}</h2>
      {section.paragraphs?.map((p) => <p set:html={formatInline(p)} />)}
      {section.bullets && section.bullets.length > 0 && (
        <ul class="scan-list">
          {section.bullets.map((item) => (
            <li set:html={formatInline(item)} />
          ))}
        </ul>
      )}
      {section.table && (
        <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
          <table>
            <thead>
              <tr>
                {section.table.headers.map((h) => (
                  <th set:html={formatInline(h)} />
                ))}
              </tr>
            </thead>
            <tbody>
              {section.table.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td set:html={formatInline(cell)} />
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {section.affiliates && section.affiliates.length > 0 && (
        <AffRow items={section.affiliates} />
      )}
    </section>
  ))}

  {
    useGuideGrid && (
      <section class="place-section" id="related">
        <h2>{guideGridHeading(page.path)}</h2>
        <div class="guide-grid">
          {portraits.map((item) => (
            <a class="guide-card" href={pageHref(item.href)}>
              <img src={item.photo} alt={item.title} width="640" height="400" loading="lazy" decoding="async" />
              <span>
                <strong>{item.title}</strong>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    page.days && page.days.length > 0 && (
      <section class="place-section" id="days">
        <h2>Day by day</h2>
        <div class="day-cards">
          {days.map((day) => (
            <article class="day-plan-card" id={`day-${day.n}`}>
              <div class="media">
                <img src={day.photo} alt={`Day ${day.n}: ${day.title}`} width="960" height="400" loading="lazy" decoding="async" />
                <span class="rank-badge">{day.n}</span>
              </div>
              <div class="jg-body">
                <h2>{day.title}</h2>
                <p set:html={formatInline(day.body)} />
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    restSections.map((section) => (
      <section class="place-section" id={section.id}>
        <h2>{section.title}</h2>
        {section.paragraphs?.map((p) => <p set:html={formatInline(p)} />)}
        {section.cards && section.cards.length > 0 && (
          <div class="editorial-grid">
            {section.cards.map((card) => (
              <article class="editorial-card">
                {card.photo && (
                  <div class="editorial-media">
                    {card.href ? (
                      <a href={pageHref(card.href)} tabindex="-1" aria-hidden="true">
                        <img src={card.photo} alt={card.title} width="640" height="400" loading="lazy" decoding="async" />
                      </a>
                    ) : (
                      <img src={card.photo} alt={card.title} width="640" height="400" loading="lazy" decoding="async" />
                    )}
                  </div>
                )}
                <div class="editorial-body">
                  <span class="editorial-kicker">{card.kicker}</span>
                  <h3>
                    {card.href ? <a href={pageHref(card.href)}>{card.title}</a> : card.title}
                  </h3>
                  {card.lead && <p class="editorial-lead" set:html={formatInline(card.lead)} />}
                  <ul class="editorial-bullets">
                    {card.bullets.map((item) => (
                      <li set:html={formatInline(item)} />
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        )}
        {section.bullets && section.bullets.length > 0 && (
          <ul class="scan-list">
            {section.bullets.map((item) => (
              <li set:html={formatInline(item)} />
            ))}
          </ul>
        )}
        {section.table && (
          <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
            <table>
              <thead>
                <tr>
                  {section.table.headers.map((h) => (
                    <th set:html={formatInline(h)} />
                  ))}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td set:html={formatInline(cell)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {section.affiliates && section.affiliates.length > 0 && (
          <AffRow items={section.affiliates} />
        )}
      </section>
    ))
  }

  {
    !useGuideGrid && portraits.length > 0 && (
      <section class="place-section" id="related">
        <h2>Keep going</h2>
        <PortraitRail label={page.title} items={portraits} />
      </section>
    )
  }

  {
    affiliates.length > 0 && (
      <section class="place-section" id="book">
        <h2>Book</h2>
        <AffRow items={affiliates} />
      </section>
    )
  }

  {
    stayLinks.length > 0 && (
      <section class="place-section" id="stay">
        <h2>Where to stay on arrival</h2>
        <ul>
          {stayLinks.map((p) => (
            <li>
              <a href={pageHref(p.path)}>{p.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <SisterNetwork path={page.path} exclude={pageFlightKeys} max={showSisterRoutes ? 0 : 2} />
  {showSisterRoutes && <SisterRoutes path={page.path} exclude={pageFlightKeys} />}

  {
    page.path === '/about' && (
      <section class="place-section" id="embed-map">
        <h2>Embed this map</h2>
        <p>Free to use on blogs and trip pages. Paste this code where the map should appear.</p>
        <pre class="embed-code"><code>{'<iframe src="https://thailand-travelguide.com/embed/map/" width="360" height="640" style="border:0;max-width:100%" loading="lazy" title="Thailand region map"></iframe>'}</code></pre>
      </section>
    )
  }

  {
    page.faqs.length > 0 && (
      <section class="place-section" id="questions">
        <h2>Common questions</h2>
        <FaqList items={page.faqs} />
      </section>
    )
  }
</article>

