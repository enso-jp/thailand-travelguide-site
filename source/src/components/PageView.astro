---
import FactBar from './FactBar.astro';
import PortraitRail from './PortraitRail.astro';
import AffRow from './AffRow.astro';
import FaqList from './FaqList.astro';
import type { Page } from '../lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const tabs = page.tabs;
const HUB_GRIDS = new Set([
  '/destinations',
  '/itineraries',
  '/plan',
  '/get-there',
  '/interests',
  '/thai-food',
  '/attractions',
  '/interests/resort-living',
]);
const useGuideGrid = HUB_GRIDS.has(page.path) && (page.portraits?.length || 0) > 0;
---

<article class="section wrap">
  {
    page.crumbs.length > 1 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {page.crumbs.map((crumb) => (
            <li>
              <a href={crumb.href}>{crumb.name}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <header>
    <h1>{page.title}</h1>
    <p class="lede">{page.lede}</p>
    {
      page.parentPill && page.parentPill.href !== page.path && (
        <a class="parent-pill" href={page.parentPill.href}>
          <span>Back to</span> {page.parentPill.name}
        </a>
      )
    }
    {
      page.chips && page.chips.length > 0 && (
        <div class="chips">
          {page.chips.map((chip) => (
            <span class="chip peak">{chip}</span>
          ))}
        </div>
      )
    }
    {
      page.photo && (
        <div class="place-photo">
          <img src={page.photo} alt={page.title} width="960" height="540" loading="eager" decoding="async" />
        </div>
      )
    }
    {page.photoCredit && <p class="note photo-credit">{page.photoCredit}</p>}
  </header>

  <FactBar facts={page.facts} />

  {
    page.bookingCta && (
      <div class="booking-cta" aria-label="Book stays and tickets">
        <a href={page.bookingCta.stayHref} rel="sponsored noopener" target="_blank">
          <strong>{page.bookingCta.stayLabel}</strong>
          <em>{page.bookingCta.stayNote}</em>
        </a>
        <a href={page.bookingCta.tourHref} rel="sponsored noopener" target="_blank">
          <strong>{page.bookingCta.tourLabel}</strong>
          <em>{page.bookingCta.tourNote}</em>
        </a>
      </div>
    )
  }

  {
    tabs && tabs.length > 0 && (
      <nav class="tabs" aria-label="Sections">
        {tabs.map((tab) => (
          <a href={tab.href} aria-current={tab.current ? 'page' : undefined}>
            {tab.label}
          </a>
        ))}
      </nav>
    )
  }

  <div class="reading">
    {page.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  {
    page.days && page.days.length > 0 && (
      <section class="place-section" id="days">
        <h2>Day by day</h2>
        <div class="day-cards">
          {page.days.map((day) => (
            <article class="day-plan-card" id={`day-${day.n}`}>
              <div class="media">
                <img src={day.photo} alt="" width="960" height="400" loading="lazy" decoding="async" />
                <span class="rank-badge">{day.n}</span>
              </div>
              <div class="jg-body">
                <h2>{day.title}</h2>
                <p>{day.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    page.sections?.map((section) => (
      <section class="place-section" id={section.id}>
        <h2>{section.title}</h2>
        {section.paragraphs?.map((p) => <p>{p}</p>)}
        {section.table && (
          <table>
            <thead>
              <tr>
                {section.table.headers.map((h) => (
                  <th>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {section.table.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    ))
  }

  {
    useGuideGrid && (
      <section class="place-section" id="related">
        <h2>Every guide on this hub</h2>
        <div class="guide-grid">
          {page.portraits!.map((item) => (
            <a class="guide-card" href={item.href}>
              <img src={item.photo} alt={item.title} width="640" height="400" loading="lazy" decoding="async" />
              <span>
                <strong>{item.title}</strong>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    !useGuideGrid && page.portraits && page.portraits.length > 0 && (
      <section class="place-section" id="related">
        <h2>Keep going</h2>
        <PortraitRail label={page.title} items={page.portraits} />
      </section>
    )
  }

  {
    page.affiliates && page.affiliates.length > 0 && (
      <section class="place-section" id="book">
        <h2>Book</h2>
        <AffRow items={page.affiliates} />
      </section>
    )
  }

  {
    page.faqs.length > 0 && (
      <section class="place-section" id="questions">
        <h2>Common questions</h2>
        <FaqList items={page.faqs} />
      </section>
    )
  }
</article>
