---
import {
  tripCities,
  hotelSearchListUrl,
  klookTours,
  transferLink,
  trainLink,
  cityAirports,
  type StayCity,
} from '../lib/partners';

interface Props {
  variant?: 'home' | 'destination' | 'food';
  city?: StayCity;
  placeName?: string;
  showMore?: boolean;
}

const { variant = 'destination', city = 'bangkok', placeName = 'Thailand', showMore = variant !== 'home' } = Astro.props;

const cityOptions = (Object.keys(tripCities) as StayCity[]).map((id) => ({
  id,
  label: tripCities[id].name,
}));

const linksMap = Object.fromEntries(
  cityOptions.map((opt) => [opt.id, hotelSearchListUrl(opt.id, { trip_sub1: `${opt.label} Search Box` })]),
);

const tours = klookTours(`${placeName} tours`);
const transfer = transferLink(cityAirports[city] || 'BKK');
const trains = trainLink('Bangkok', placeName);
---

<div class:list={['trip-cta', `trip-cta-${variant}`]} data-partner="stay" data-trip-box>
  <h2 class="trip-cta-title">Book your <em>stay</em></h2>
  <span class="trip-cta-kicker">Trip.com</span>
  <form class="trip-search-form" data-trip-search-form>
    <label class="trip-field">
      <span>Destination</span>
      <select name="city" data-trip-city>
        {
          cityOptions.map((opt) => (
            <option value={opt.id} selected={opt.id === city}>
              {opt.label}
            </option>
          ))
        }
      </select>
    </label>
    <div class="trip-search-dates">
      <label class="trip-field">
        <span>Check-in</span>
        <input type="date" name="checkin" data-trip-in required />
      </label>
      <label class="trip-field">
        <span>Check-out</span>
        <input type="date" name="checkout" data-trip-out required />
      </label>
    </div>
    <label class="trip-field">
      <span>Guests / Rooms</span>
      <select name="guests" data-trip-guests>
        <option value="2-1" selected>2 adults, 1 room</option>
        <option value="1-1">1 adult, 1 room</option>
        <option value="3-1">3 adults, 1 room</option>
        <option value="4-2">4 adults, 2 rooms</option>
      </select>
    </label>
    <button type="submit" class="trip-cta-btn">Search hotels</button>
    <span class="trip-cta-sub">Compare rooms and rates for your dates. We may earn a commission.</span>
  </form>
  <script type="application/json" data-trip-links set:html={JSON.stringify(linksMap)} />
</div>
{
  showMore && (
    <p class="trip-more">
      <a href={tours} rel="sponsored noopener" target="_blank">
        Klook tours
      </a>
      ·
      <a href={transfer} rel="sponsored noopener" target="_blank">
        Airport car
      </a>
      ·
      <a href={trains} rel="sponsored noopener" target="_blank">
        Trains
      </a>
    </p>
  )
}
