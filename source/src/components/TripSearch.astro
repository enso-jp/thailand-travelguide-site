---
const _now = new Date();
const _in = new Date(_now); _in.setDate(_in.getDate() + 1);
const _out = new Date(_now); _out.setDate(_out.getDate() + 4);
const defaultCheckin = _in.toISOString().slice(0, 10);
const defaultCheckout = _out.toISOString().slice(0, 10);
import { tripCities, stayLink, klookTours, transferLink, trainLink, type StayCity } from '../lib/partners';

interface Props {
  variant?: 'home' | 'destination' | 'food';
  city?: StayCity;
  placeName?: string;
}

const { variant = 'destination', city = 'bangkok', placeName = 'Thailand' } = Astro.props;

const cityOptions = (Object.keys(tripCities) as StayCity[]).map((id) => ({
  id,
  label: tripCities[id].name,
  stay: stayLink(id, { trip_sub1: `${tripCities[id].name} Search Box` }),
}));

const linksMap = Object.fromEntries(cityOptions.map((c) => [c.id, c.stay]));

const tours = klookTours(`${placeName} tours`);
const transfer = transferLink(
  city === 'phuket'
    ? 'HKT'
    : city === 'chiang-mai'
      ? 'CNX'
      : city === 'koh-samui'
        ? 'USM'
        : city === 'krabi'
          ? 'KBV'
          : 'BKK',
);
const trains = trainLink('Bangkok', placeName);
---

<div class:list={['trip-cta', `trip-cta-${variant}`]} data-partner="stay" data-trip-box>
  <span class="trip-cta-kicker">Trip.com</span>
  <form class="trip-search-form" data-trip-search-form>
    <label>
      Destination
      <select name="city" data-trip-city>
        {
          cityOptions.map((opt) => (
            <option value={opt.id} selected={opt.id === city}>
              {opt.label}
            </option>
          ))
        }
      </select>
    </label>
    <div class="trip-search-dates">
      <label>
        Check-in
        <input type="date" name="checkin" value={defaultCheckin} data-trip-in required />
      </label>
      <label>
        Check-out
        <input type="date" name="checkout" value={defaultCheckout} data-trip-out required />
      </label>
    </div>
    <label>
      Guests
      <select name="guests" data-trip-guests>
        <option value="2-1" selected>2 adults, 1 room</option>
        <option value="1-1">1 adult, 1 room</option>
        <option value="3-1">3 adults, 1 room</option>
        <option value="4-2">4 adults, 2 rooms</option>
      </select>
    </label>
    <button type="submit" class="trip-cta-btn">Search hotels</button>
    <span class="trip-cta-sub">Compare free-cancellation rooms and nightly rates for your dates.</span>
  </form>
  <script type="application/json" data-trip-links set:html={JSON.stringify(linksMap)} />
</div>
<p class="trip-more">
  <a href={tours} rel="sponsored noopener" target="_blank">Klook tours</a>
  ·
  <a href={transfer} rel="sponsored noopener" target="_blank">Airport car</a>
  ·
  <a href={trains} rel="sponsored noopener" target="_blank">Trains</a>
</p>
