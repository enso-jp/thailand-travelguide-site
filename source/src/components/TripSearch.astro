---
import {
  klookTours,
  klookCityLink,
  klookFallbackCta,
  klookFoodLink,
  transferLink,
  trainLink,
  railDestination,
  cityAirports,
  type StayCity,
  stayCityFromPath,
} from '../lib/partners';
import { TRIP_CITY_SEARCH_BOXES } from '../lib/trip-searchboxes';

interface Props {
  variant?: 'home' | 'destination' | 'food';
  city?: StayCity;
  placeName?: string;
  showMore?: boolean;
  skipTours?: boolean;
  skipHrefs?: string[];
}

const { variant = 'destination', city = 'bangkok', placeName = 'Thailand', showMore = variant !== 'home', skipTours = false, skipHrefs = [] } = Astro.props;

/** Trip.com Partner search box S20729725 (SID 334804079). Pasted exactly as generated. Never edit. */
const TRIP_SEARCH_BOX_EMBED = "<iframe border=\"0\" src=\"https://www.trip.com/partners/ad/S20729725?Allianceid=11105102&SID=334804079&trip_sub1=th_search_box\" style=\"width:320px;height:320px\" frameborder=\"0\" scrolling=\"no\" style=\"border:none\" id=\"S20729725\"></iframe>";

const boxCity = variant === 'home' ? undefined : stayCityFromPath(Astro.url.pathname, true);
const searchBoxEmbed = (boxCity && TRIP_CITY_SEARCH_BOXES[boxCity]?.embed) || TRIP_SEARCH_BOX_EMBED;

const pathText = Astro.url.pathname.replace(/[-/]/g, ' ');
const tours = (variant === 'food' ? klookFoodLink(`${placeName} ${pathText}`, true) : undefined) || klookCityLink(Astro.url.pathname.replace(/[-/]/g, ' ')) || klookCityLink(placeName) || klookTours(`${placeName} tours`);
const toursCta = klookFallbackCta(tours);
const transfer = transferLink(cityAirports[city] || 'BKK');
const railTo = railDestination(placeName);
const trainsRaw = railTo ? trainLink('Bangkok', railTo) : null;
// Links already in the page's getting-there content are not repeated here.
const trains = trainsRaw && !skipHrefs.includes(trainsRaw) ? trainsRaw : null;
const showTransfer = !skipHrefs.includes(transfer);
---

<div class:list={['trip-cta', `trip-cta-${variant}`]} data-partner="stay" data-trip-box>
  <h2 class="trip-cta-title">Book your <em>stay</em></h2>
  <span class="trip-cta-kicker">Trip.com</span>
  <div class="trip-cta-embed" set:html={searchBoxEmbed} />
  <span class="trip-cta-sub">Compare rooms and rates for your dates. We may earn a commission.</span>
</div>
{
  showMore && (
    <p class="trip-more">
      {!skipTours && (
        <>
      <a href={tours} rel="sponsored noopener" target="_blank">
        {toursCta ? toursCta.short : 'Klook tours'}
      </a>
      ·
        </>
      )}
      {showTransfer && (
        <a href={transfer} rel="sponsored noopener" target="_blank">
          Airport car
        </a>
      )}
      {trains && (
        <>
          {showTransfer && '·'}
          <a href={trains} rel="sponsored noopener" target="_blank">
            Trains
          </a>
        </>
      )}
    </p>
  )
}
