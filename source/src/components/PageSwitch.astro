---
import DestinationsView from './DestinationsView.astro';
import FoodGuideView from './FoodGuideView.astro';
import FoodHubView from './FoodHubView.astro';
import HomeView from './HomeView.astro';
import InterestsView from './InterestsView.astro';
import PageView from './PageView.astro';
import PlaceView from './PlaceView.astro';
import type { Page } from '../lib/content';
import { isPlacePage } from '../lib/place-attractions';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

{
  page.path === '/' ? (
    <HomeView />
  ) : page.path === '/destinations' ? (
    <DestinationsView page={page} />
  ) : page.path === '/thai-food' ? (
    <FoodHubView page={page} />
  ) : page.path.startsWith('/thai-food/') ? (
    <FoodGuideView page={page} />
  ) : page.path === '/interests' ? (
    <InterestsView page={page} />
  ) : isPlacePage(page.path) ? (
    <PlaceView page={page} />
  ) : (
    <PageView page={page} />
  )
}
