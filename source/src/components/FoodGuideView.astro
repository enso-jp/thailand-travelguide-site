---
import CheckedLine from './CheckedLine.astro';
import AffRow from './AffRow.astro';
import FactBar from './FactBar.astro';
import FaqList from './FaqList.astro';
import Photo from './Photo.astro';
import SisterNetwork from './SisterNetwork.astro';
import TripSearch from './TripSearch.astro';
import type { Page } from '../lib/content';
import { assignExactPhotos, foodRowsFor } from '../lib/dish-photos';
import { chipHref, formatInline } from '../lib/inline';
import { UniquePhotos } from '../lib/photos';
import { klookTours, klookFallbackCta, klookFoodLink, stayCityFromPath, type StayCity } from '../lib/partners';
import { pageHref, routePath } from '../lib/site';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const reserved = page.photo ? [page.photo] : [];
const rows = foodRowsFor(page.path, reserved);
const bag = new UniquePhotos([...reserved, ...rows.map((row) => row.photo).filter(Boolean) as string[]]);
const portraits = bag.takeBatch(page.portraits || [], (item) => `${page.path} ${item.title} ${item.href}`);
const affiliates = bag.takeBatch(page.affiliates || [], (item) => `${page.path} ${item.title} ${item.kicker} ${item.body}`);
const city: StayCity = stayCityFromPath(page.path);
const foodTourHref = klookFoodLink(`${page.title} ${Astro.url.pathname.replace(/[-/]/g, ' ')}`, true) || klookTours(`${page.title} food tour`);
const foodTourCta = klookFallbackCta(foodTourHref);
---

<article class="wrap food-guide-page">
  <header class="place-top" id="intro">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {page.crumbs.map((crumb) => (
          <li><a href={pageHref(crumb.href)}>{crumb.name}</a></li>
        ))}
      </ol>
    </nav>
    <h1>
      {page.title}
      {page.alternateName && <span class="vi" lang="th"> {page.alternateName}</span>}
    </h1>
    <CheckedLine path={page.path} />
    <p class="lede" set:html={formatInline(page.lede)} />
    {
      page.chips && (
        <div class="chips">
          {page.chips.map((chip) => {
            const href = chipHref(chip, page.parentPill, page.path);
            return href && routePath(href) !== page.path ? <a class="pill" href={pageHref(href)}>{chip}</a> : <span class="chip peak">{chip}</span>;
          })}
          <a class="pill" href={pageHref('/thai-food')}>Thai food hub</a>
        </div>
      )
    }
    {
      page.photo && (
        <div class="place-photo">
          <Photo src={page.photo} alt={page.title} priority />
        </div>
      )
    }
    {page.photoCredit && <p class="note photo-credit">{page.photoCredit}</p>}
  </header>

  <FactBar facts={page.facts} />

  <div class="place-grid food-guide">
    <div>
      <div class="reading">
        <div class="food-intro" id="intro-copy">
          {page.paragraphs.map((p) => <p set:html={formatInline(p)} />)}
        </div>
      </div>

      {
        rows.length > 0 && (
          <section class="place-section" id="specialties">
            <h2>Specialties</h2>
            <ul class="food-highlights">
              {rows.map((row) => (
                <li><a href={`#${row.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{row.title}</a></li>
              ))}
            </ul>
            {rows.map((row) => (
              <article class:list={['food-row', { 'is-text': !row.photo }]} id={row.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
                {
                  row.photo && (
                    <a class="food-row-photo" href={pageHref(row.href)}>
                      <Photo src={row.photo} alt={`${row.title}, ${row.nameLocal}`} />
                    </a>
                  )
                }
                <div>
                  <h3>
                    <a href={pageHref(row.href)}>
                      {row.title} <span class="vi" lang="th">{row.nameLocal}</span>
                    </a>
                  </h3>
                  <p set:html={formatInline(row.summary)} />
                  {row.address && <div class="spot-address">{row.address}</div>}
                  {(row.hours || row.price) && (
                    <div class="spot-address">
                      {[row.hours, row.price].filter(Boolean).join(' · ')}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </section>
        )
      }

      {
        page.sections?.map((section) => (
          <section class="place-section" id={section.id}>
            <h2>{section.title}</h2>
            {section.paragraphs?.map((p) => <p set:html={formatInline(p)} />)}
            {section.bullets && (
              <ul class="scan-list">
                {section.bullets.map((item) => (
                  <li set:html={formatInline(item)} />
                ))}
              </ul>
            )}
            {section.table && (
              <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
                <table>
                  <thead>
                    <tr>{section.table.headers.map((h) => <th set:html={formatInline(h)} />)}</tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>{row.map((cell) => <td set:html={formatInline(cell)} />)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))
      }

      {
        portraits.length > 0 && rows.length === 0 && (
          <section class="place-section" id="related">
            <h2>More food guides</h2>
            <div class="food-grid">
              {portraits.map((item) => (
                <a class="food-card" href={pageHref(item.href)}>
                  {item.photo && <span class="media"><Photo src={item.photo} alt={item.title} /></span>}
                  <strong>{item.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {affiliates.length > 0 && (
        <section class="place-section" id="book">
          <h2>Book</h2>
          <AffRow items={affiliates} />
        </section>
      )}

      <SisterNetwork path={page.path} />

      {page.faqs.length > 0 && (
        <section class="place-section" id="questions">
          <h2>Common questions</h2>
          <FaqList items={page.faqs} />
        </section>
      )}
    </div>

    <aside class="rail">
      <div class="rail-booking">
        <TripSearch variant="food" city={city} placeName={page.title} skipTours={true} />
        {!affiliates.some((a) => a.href === foodTourHref) && <a class="promo-box" href={foodTourHref} rel="sponsored noopener" target="_blank">
          <strong>{foodTourCta ? foodTourCta.label : 'Klook food tours'}</strong>
          <span>{foodTourCta ? foodTourCta.note : 'Book a walk only if the group will not split on the MRT.'}</span>
        </a>}
      </div>
    </aside>
  </div>
</article>
