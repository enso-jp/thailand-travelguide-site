---
export interface Affiliate {
  title: string;
  kicker: string;
  body: string;
  href: string;
  cta: string;
  photo?: string;
  partner?: string;
}

interface Props {
  items: Affiliate[];
}

import { klookFallbackCta } from '../lib/partners';

const { items: raw } = Astro.props;
// City tours fallback links must not promise the original activity; relabel from the city.
const items = raw.map((item) => {
  const cta = klookFallbackCta(item.href);
  return cta
    ? { ...item, title: cta.label, kicker: 'Klook', body: cta.note, cta: 'See tours' }
    : item;
});
---

{
  items.length > 0 && (
    <ul class="aff-list">
      {
        items.map((item) => (
          <li>
            <a
              class:list={['aff-row', { 'aff-row--no-photo': !item.photo }]}
              href={item.href}
              rel="sponsored noopener"
              target="_blank"
              data-partner={item.partner ?? 'stay'}
            >
              {
                item.photo && (
                  <span class="aff-photo">
                    <img src={item.photo} alt="" width="320" height="200" loading="lazy" decoding="async" />
                  </span>
                )
              }
              <span class="aff-copy">
                <strong>{item.title}</strong>
                <em>{item.kicker}</em>
                <p>{item.body}</p>
                <span class="aff-btn">{item.cta}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  )
}
