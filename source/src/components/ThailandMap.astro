---
import { MAP_PINS, THAILAND_PROVINCES, type RegionSlug } from '../lib/regions';

interface Props {
  variant?: 'home' | 'rail';
  active?: RegionSlug | string;
  linked?: boolean;
}

const { variant = 'home', active = 'central', linked = true } = Astro.props;
const isCompact = variant === 'rail';
---

<svg
  class:list={[
    'map-svg',
    'map-thailand',
    { 'map-home': variant === 'home', 'map-compact': isCompact, 'map-picked': true },
  ]}
  viewBox="0 0 360 640"
  preserveAspectRatio={isCompact ? 'xMidYMid meet' : 'xMidYMin meet'}
  role="img"
  aria-label="Map of Thailand by region"
>
  {
    THAILAND_PROVINCES.map((prov) => {
      const isActive = prov.region === active || prov.name === active;
      if (linked) {
        return (
          <a
            class:list={['map-hit', 'map-province', { 'is-active': isActive }]}
            href={prov.href}
            data-region={prov.region}
            data-province={prov.name}
            data-corridor-name={prov.corridor}
          >
            <title>{prov.name}</title>
            <path d={prov.d} />
          </a>
        );
      }
      return (
        <g
          class:list={['map-province', { 'is-active': isActive }]}
          data-region={prov.region}
          data-province={prov.name}
          data-corridor-name={prov.corridor}
        >
          <title>{prov.name}</title>
          <path d={prov.d} />
        </g>
      );
    })
  }
  {
    !isCompact && (
      <g class="map-pins" aria-hidden="true">
        {MAP_PINS.map((pin) => (
          <g
            class:list={['map-pin', { 'is-active': Boolean(pin.region && pin.region === active) }]}
            data-region={pin.region}
            data-province={pin.province}
          >
            <circle cx={pin.x} cy={pin.y} r="4.4" />
            <text x={pin.lx} y={pin.ly} text-anchor={pin.anchor}>
              {pin.name}
            </text>
          </g>
        ))}
      </g>
    )
  }
</svg>
