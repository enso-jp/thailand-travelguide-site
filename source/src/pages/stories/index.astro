---
import Base from '../../layouts/Base.astro';
import { pageHref } from '../../lib/site';
import { allStories, displayDate, isoDate, storiesIndexPage, storyPath } from '../../lib/stories';

const page = storiesIndexPage();
const stories = await allStories();
---

<Base page={page}>
  <article class="section wrap stories-index">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {page.crumbs.map((crumb) => (
          <li><a href={pageHref(crumb.href)}>{crumb.name}</a></li>
        ))}
      </ol>
    </nav>
    <p class="eyebrow">Stories</p>
    <h1>Thailand travel stories</h1>
    <p class="lede">{page.lede}</p>
    <ul class="story-list">
      {
        stories.map((story, i) => (
          <li>
            <a class="story-card" href={pageHref(storyPath(story))}>
              <span class="story-card-media">
                <img src={story.data.photo} alt="" width="720" height="480" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              </span>
              <span class="story-card-copy">
                <span class="story-card-meta">
                  {story.data.category} · <time datetime={isoDate(story.data.date)}>{displayDate(story.data.date)}</time>
                </span>
                <strong>{story.data.title}</strong>
                <span class="story-card-dek">{story.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</Base>
