---
import CheckedLine from '../../components/CheckedLine.astro';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { pageHref } from '../../lib/site';
import { generatedKlookLink, generatedStayLink, tripCities } from '../../lib/partners';
import { allStories, displayDate, isoDate, storyPage } from '../../lib/stories';

export async function getStaticPaths() {
  const stories = await allStories();
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const d = story.data;
const page = storyPage(story);
const { Content } = await render(story);

// Only Partner-generated links are used. Unknown keys render nothing.
const stayHref = d.stayCity ? generatedStayLink(d.stayCity) : undefined;
const stayName = d.stayCity && d.stayCity in tripCities ? tripCities[d.stayCity as keyof typeof tripCities].name : undefined;
const tourHref = d.tourQuery ? generatedKlookLink(d.tourQuery) : undefined;
---

<Base page={page} documentTitle={d.seoTitle ?? (d.title.length <= 60 ? d.title : undefined)}>
  <article class="section wrap story">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {page.crumbs.slice(0, 2).map((crumb) => (
          <li><a href={pageHref(crumb.href)}>{crumb.name}</a></li>
        ))}
      </ol>
    </nav>
    <p class="eyebrow">{d.category} · <time datetime={isoDate(d.date)}>{displayDate(d.date)}</time></p>
    <h1>{d.title}</h1>
    <CheckedLine path={page.path} />
    <p class="lede">{d.lede}</p>
    {d.note && <p class="note">{d.note}</p>}
    <figure class="place-photo">
      <img src={d.photo} alt={d.photoAlt} width="1440" height="960" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption class="photo-credit">{d.photoCredit}</figcaption>
    </figure>
    <div class="story-body">
      <Content />
    </div>
    {
      (d.related.length > 0 || stayHref || tourHref) && (
        <aside class="story-next" aria-label="Plan it">
          <h2>Plan it</h2>
          <ul>
            {d.related.map((r) => (
              <li><a href={pageHref(r.href)}>{r.label}</a></li>
            ))}
            {stayHref && stayName && (
              <li><a href={stayHref} rel="sponsored noopener" target="_blank" data-partner="stay">Compare hotels in {stayName} on Trip.com</a></li>
            )}
            {tourHref && (
              <li><a href={tourHref} rel="sponsored noopener" target="_blank" data-partner="tours">Tours on Klook</a></li>
            )}
          </ul>
        </aside>
      )
    }
  </article>
</Base>
